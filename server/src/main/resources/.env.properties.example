# Copy this file to .env.properties and fill in your values.
# .env.properties is git-ignored and must never be committed.

# --- Supabase (required) ---
# Found in: Supabase Dashboard > Project Settings > API
SUPABASE_JWK_SET_URI=https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Your PostgreSQL host (e.g. Docker service name "db", or a remote host)
POSTGRES_HOST=db
POSTGRES_PASSWORD=<your-database-password>

# --- Admin (optional) ---
# Comma-separated player UUIDs that get admin privileges in-game
ADMIN_PLAYER_IDS=

# --- Discord (optional) ---
# Leave blank to disable Discord notifications
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL_TEXT=
DISCORD_BOT_TOKEN=
